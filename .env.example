# Modest Ummah — Environment Variables
# Copy this to .env and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Modest Ummah"

# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# JWT Secret (generate a random string, min 32 chars)
JWT_SECRET=change-this-to-a-random-secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Scheduled publish cron (app/api/cron/publish) — shared secret header
# x-cron-secret. Dokploy cron hits https://APP/api/cron/publish every 5 min.
CRON_SECRET=change-this-to-a-random-string

# ─── Pirate Ship connector ────────────────────────────────────────────────
# Pirate Ship has no public API; it imports orders from store platforms. This
# app serves a WooCommerce-compatible REST surface at /wp-json/wc/v3 so Pirate
# Ship can connect to it as a self-hosted WooCommerce store.
#
# Kill switch. Until this is exactly "true", every /wp-json request 404s.
WOO_SHIM_ENABLED=false

# Encrypts stored consumer secrets at rest (AES-256-GCM). OAuth 1.0a signs
# requests with the secret rather than sending it, so the server needs the
# plaintext back — a hash cannot serve that scheme. 32 bytes of hex:
#   openssl rand -hex 32
# Optional: falls back to a value derived from JWT_SECRET. Changing either one
# makes existing API keys unusable for OAuth; regenerate them if you rotate.
WOO_SECRET_ENC_KEY=

# Hosts allowed to receive credentials from /wc-auth/v1/authorize, the
# WooCommerce key-exchange flow Pirate Ship uses. That endpoint mints a
# read_write key and POSTs it to a URL taken from the query string, so the
# destination is allowlisted rather than trusted. Comma-separated; subdomains
# of each entry are included. Defaults to pirateship.com when unset.
WOO_AUTH_CALLBACK_HOSTS=pirateship.com

# Ship-from address printed on labels. Without these lib/shipping.ts falls
# back to the placeholder "123 Business St, New York, NY 10001" — which would
# print on real postage.
PIRATESHIP_ORIGIN_NAME="Modest Ummah"
PIRATESHIP_ORIGIN_COMPANY="Modest Ummah"
PIRATESHIP_ORIGIN_STREET1=
PIRATESHIP_ORIGIN_STREET2=
PIRATESHIP_ORIGIN_CITY=
PIRATESHIP_ORIGIN_STATE=
PIRATESHIP_ORIGIN_ZIP=
PIRATESHIP_ORIGIN_PHONE=
PIRATESHIP_ORIGIN_EMAIL=

# Brevo transactional email. Required for the "your order has shipped" email
# that fires when Pirate Ship writes a tracking number back.
BREVO_API_KEY=
