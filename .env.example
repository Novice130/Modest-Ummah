# Modest Ummah — Environment Variables
# Copy this to .env and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Modest Ummah"

# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# JWT Secret (generate a random string, min 32 chars)
JWT_SECRET=change-this-to-a-random-secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Scheduled publish cron (app/api/cron/publish) — shared secret header
# x-cron-secret. Dokploy cron hits https://APP/api/cron/publish every 5 min.
CRON_SECRET=change-this-to-a-random-string
