<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ draws its own splash from these and the launcher icon. -->
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it runs. Stripe's payment sheet needs a
         descendant of Theme.AppCompat here. -->
    <style name="NormalTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
